rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario inició sesión
    function isAuthenticated() {
      return request.auth != null;
    }

    // Colección de Espacios Físicos (Lectura pública para ver disponibilidad, escritura para autenticados)
    match /spaces/{spaceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Colección de Personas
    match /people/{personId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Colección de Eventos (Lectura pública para el calendario, escritura para autenticados)
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // Solicitudes de Participación (Permite consultar y confirmar/rechazar mediante token)
    match /participation_requests/{requestId} {
      allow read, update: if true;
      allow create, delete: if isAuthenticated();
    }

    // Notificaciones
    match /notifications/{notifId} {
      allow read, write: if isAuthenticated();
    }

    // Logs de Auditoría (Trazabilidad inmutable)
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Usuarios del sistema
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
  }
}
