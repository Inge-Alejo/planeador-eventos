rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario inició sesión
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identificar al Superadministrador institucional por correo verificado o claim
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'proyectostic.med@udea.edu.co';
    }

    // Obtener los datos del perfil del usuario en Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verificar si el usuario tiene rol de Administrador y estado Aprobado
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'administrador' && 
        getUserData().status == 'aprobado'
      );
    }

    // Verificar si el usuario tiene permisos de edición (Admin o Gestor/Editor Aprobado)
    function isEditorOrAdmin() {
      return isAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (getUserData().role == 'gestor' || getUserData().role == 'editor' || getUserData().role == 'administrador') && 
        getUserData().status == 'aprobado'
      );
    }

    // Colección de Espacios Físicos (Lectura pública para disponibilidad, modificación/borrado por administradores)
    match /spaces/{spaceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección de Personas (Directorio institucional visible para cualquier dispositivo y sesión)
    match /people/{personId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Colección de Grupos de Personas (Gestión institucional visible en cualquier sesión)
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Función para verificar si un usuario es el creador del evento
    function isEventCreator(eventData) {
      return isAuthenticated() && (
        eventData.createdBy == request.auth.uid || 
        eventData.createdByEmail == request.auth.token.email
      );
    }

    // Colección de Eventos
    // Lectura pública para consulta de calendario
    // Creación para editores/administradores aprobados
    // Modificación general restringida estrictamente al Creador del evento o Superadministrador institucional
    // Modificación de autorizaciones excepcionales restringida exclusivamente a Superadmin (proyectostic.med@udea.edu.co)
    match /events/{eventId} {
      allow read: if true;
      allow create: if isEditorOrAdmin();
      allow update: if isAuthenticated() && (
        // Superadministrador institucional tiene acceso maestro
        isSuperAdmin() ||
        // El creador original puede modificar su evento
        isEventCreator(resource.data) ||
        // Si no es el creador pero es editor/admin, sólo puede actualizar tareas sin modificar campos generales ni autorizaciones
        (
          isEditorOrAdmin() &&
          request.resource.data.title == resource.data.title &&
          request.resource.data.date == resource.data.date &&
          request.resource.data.startTime == resource.data.startTime &&
          request.resource.data.endTime == resource.data.endTime &&
          request.resource.data.spaceId == resource.data.spaceId &&
          request.resource.data.isVirtual == resource.data.isVirtual &&
          request.resource.data.exceptionalApproval == resource.data.exceptionalApproval
        )
      );
      allow delete: if isSuperAdmin() || isEventCreator(resource.data);
    }

    // Colección de Programaciones Automáticas de Informes (Exclusivo Superadmin)
    match /report_schedules/{scheduleId} {
      allow read, write: if isSuperAdmin();
    }

    // Colección de Logs de Ejecución de Reportes (Exclusivo Superadmin)
    match /report_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Colección de Logs de Recordatorios Automáticos
    match /reminder_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Tareas Personales (Aislamiento Multi-Tenant por usuario propietario y administradores)
    match /personal_tasks/{taskId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.token.email ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.token.email ||
        isAdmin()
      );
    }

    // Solicitudes de Participación (Lectura pública y actualización por token de email)
    match /participation_requests/{requestId} {
      allow read: if true;
      allow create, delete: if isEditorOrAdmin();
      allow update: if true; // Confirmación/rechazo mediante tokens hash únicos
    }

    // Notificaciones (Acceso seguro: administradores o destinatario específico)
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && (
        isAdmin() || 
        resource.data.recipientEmail == request.auth.token.email ||
        resource.data.userId == request.auth.token.email ||
        resource.data.userId == request.auth.uid ||
        resource.data.recipientEmail == 'ALL_ADMINS' ||
        resource.data.userId == 'ALL_ADMINS' ||
        resource.data.recipientEmail == 'ALL'
      );
      allow create: if isAuthenticated();
    }

    // Logs de Auditoría (Trazabilidad estricta e inmutable: inserción permitida, actualización y borrado prohibidos)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Usuarios del sistema (Protección contra escalada de privilegios, lectura visible para sincronización)
    match /users/{userId} {
      allow read: if true;
      // Registro inicial: sólo se puede crear con rol lector y pendiente (o administrador/aprobado si es superadmin)
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && (
          (request.resource.data.role == 'lector' && request.resource.data.status == 'pendiente') ||
          (isSuperAdmin() && request.resource.data.role == 'administrador' && request.resource.data.status == 'aprobado')
        ))
      );
      // Actualización: un usuario no puede cambiar su propio rol ni su estado
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.status == resource.data.status)
      );
      allow delete: if isAdmin();
    }
  }
}
