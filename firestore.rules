rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar si el usuario inició sesión
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identificar al Superadministrador institucional por correo verificado o claim
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'proyectostic.med@udea.edu.co';
    }

    // Obtener los datos del perfil del usuario en Firestore
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Verificar si el usuario tiene rol de Administrador y estado Aprobado
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getUserData().role == 'administrador' && 
        getUserData().status == 'aprobado'
      );
    }

    // Verificar si el usuario tiene permisos de edición (Admin o Gestor/Editor Aprobado)
    function isEditorOrAdmin() {
      return isAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (getUserData().role == 'gestor' || getUserData().role == 'editor' || getUserData().role == 'administrador') && 
        getUserData().status == 'aprobado'
      );
    }

    // Colección de Espacios Físicos (Lectura pública para disponibilidad, modificación/borrado por administradores)
    match /spaces/{spaceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección de Personas (Directorio institucional visible para cualquier dispositivo y sesión)
    match /people/{personId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Colección de Grupos de Personas (Gestión institucional visible en cualquier sesión)
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Función para verificar si un usuario es el creador del evento
    function isEventCreator(eventData) {
      return isAuthenticated() && (
        (eventData.createdBy is map && (
          eventData.createdBy.uid == request.auth.uid || 
          eventData.createdBy.email == request.auth.token.email
        )) ||
        eventData.createdBy == request.auth.uid || 
        eventData.createdByEmail == request.auth.token.email
      );
    }

    // Colección de Eventos
    // Lectura pública para consulta de calendario en cualquier dispositivo
    // Creación y actualización para usuarios autenticados (colaboración en tiempo real en tareas, asistencia y eventos)
    // Borrado exclusivo para Superadministrador o Creador original
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin() || isEventCreator(resource.data);
    }

    // Colección de Programaciones Automáticas de Informes (Exclusivo Superadmin)
    match /report_schedules/{scheduleId} {
      allow read, write: if isSuperAdmin();
    }

    // Colección de Logs de Ejecución de Reportes (Exclusivo Superadmin)
    match /report_logs/{logId} {
      allow read, write: if isSuperAdmin();
    }

    // Colección de Logs de Recordatorios Automáticos
    match /reminder_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Tareas Personales (Lectura y escritura para usuarios autenticados en tiempo real)
    match /personal_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // Solicitudes de Participación (Lectura pública y actualización por token de email)
    match /participation_requests/{requestId} {
      allow read: if true;
      allow create, delete: if isAuthenticated();
      allow update: if true; // Confirmación/rechazo mediante tokens hash únicos
    }

    // Notificaciones (Sincronización en tiempo real para todos los usuarios autenticados)
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow update, delete: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    // Logs de Auditoría (Trazabilidad estricta e inmutable: inserción permitida, actualización y borrado prohibidos)
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Usuarios del sistema (Protección contra escalada de privilegios, lectura visible para sincronización)
    match /users/{userId} {
      allow read: if true;
      // Registro inicial: sólo se puede crear con rol lector y pendiente (o administrador/aprobado si es superadmin)
      allow create: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && (
          (request.resource.data.role == 'lector' && request.resource.data.status == 'pendiente') ||
          (isSuperAdmin() && request.resource.data.role == 'administrador' && request.resource.data.status == 'aprobado')
        ))
      );
      // Actualización: un usuario no puede cambiar su propio rol ni su estado
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.status == resource.data.status)
      );
      allow delete: if isAdmin();
    }
  }
}
