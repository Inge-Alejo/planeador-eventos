{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron-reports",
      "schedule": "0 13 1 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
