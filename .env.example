# Configuración Firebase (Reemplaza con las credenciales de tu proyecto de Firebase Console)
# Si no las configuras de inmediato, el sistema funciona automáticamente en Modo Demo Local reactivo
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment123456789
VITE_FIREBASE_AUTH_DOMAIN=eventflow-planner.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=eventflow-planner
VITE_FIREBASE_STORAGE_BUCKET=eventflow-planner.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Zona horaria oficial del sistema
VITE_APP_TIMEZONE=America/Bogota

# Correos con rol Administrador Raíz automático (separados por comas)
# Cualquier otro correo que inicie sesión entrará en estado 'pendiente' y rol 'lector' (solo consulta)
# hasta que tú como Administrador lo apruebes en el panel de usuarios.
VITE_ADMIN_EMAILS=tu_correo@gmail.com,tu_correo@udea.edu.co

